# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# Data — never commit raw EEG (large files, ~2GB per subject)
# data/raw/ is a symlink to /Volumes/Josh G/eeg-speech-data/raw — never tracked
data/raw
data/interim/
data/processed/
data/features/

# Model outputs
outputs/models/

# Per-run JSONs are regeneratable, but keep the aggregate summary
outputs/results/
!outputs/results/*/
!outputs/results/*/_batch_summary.json

# Figures — regeneratable from notebooks
outputs/figures/

# Audio side-quest — large WAVs, regeneratable via src/audio_export.py
outputs/audio/

# Batch logs — large + noisy; the JSON summaries above are the canonical record
outputs/batch_*.log

# Vendor reference repos (reference only, not our code)
vendor/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# uv lock — track if you want reproducible installs; ignore if not
# uv.lock

# macOS
.DS_Store
